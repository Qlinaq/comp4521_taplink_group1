<?xml version="1.0" encoding="utf-8"?>
<!-- Hosted by the launcher as RemoteViews, not by an activity window using Theme.TapLink.
     The widget needs its own background; lint's inferred activity-theme overdraw does not apply. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="#102C2B"
    tools:ignore="Overdraw">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/taplink_widget_brand" android:textColor="#96E3C0" android:textSize="12sp"
        android:letterSpacing="0.12" android:textStyle="bold" />
    <TextView android:id="@+id/widget_card_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/taplink_widget_card_placeholder"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_card_number" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/taplink_widget_no_card"
        android:textColor="#D1E4E0" android:textSize="13sp" />
    <TextView android:id="@+id/widget_balance" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/taplink_widget_balance_hidden"
        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/taplink_widget_demo_status"
        android:textColor="#D1E4E0" android:textSize="11sp" />
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent"
        android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/taplink_widget_open_dashboard"
        android:textColor="#96E3C0" android:textStyle="bold" android:textSize="14sp" />
</LinearLayout>
